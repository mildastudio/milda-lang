{
  "name": "@mildastudio/milda",
  "version": "0.3.1",
  "license": "MIT",
  "description": "The Milda language - a platform-neutral design language and canonical AST for design systems.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mildastudio/milda-lang.git"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:prelude": "tsx engine/prelude.check.ts"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsdown": "^0.22.14",
    "tsx": "^4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
